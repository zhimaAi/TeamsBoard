{
  "name": "goteams-client-web",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "lint": "eslint src vite.config.ts",
    "lint:fix": "eslint src vite.config.ts --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,css}\" vite.config.ts eslint.config.js env.d.ts index.html",
    "format:check": "prettier --check \"src/**/*.{vue,ts,tsx,css}\" vite.config.ts eslint.config.js env.d.ts index.html",
    "typecheck": "vue-tsc --noEmit",
    "test": "npm run typecheck",
    "build": "npm run typecheck && vite build --mode production",
    "build:prod": "npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "ant-design-vue": "^4.2.6",
    "markdown-it": "^14.3.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.67.0",
    "unplugin-vue-components": "^0.28.0",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
