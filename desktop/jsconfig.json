{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node", "electron"],
    "skipLibCheck": true
  },
  "include": ["main/**/*.cjs", "preload/**/*.cjs", "shared/**/*.cjs", "test/**/*.cjs"],
  "exclude": ["node_modules"]
}
